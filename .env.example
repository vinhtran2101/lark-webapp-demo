# PostgreSQL connection string from Neon/Supabase.
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL=""

# Private one-time/admin token used for /api/db/migrate and /api/db/seed.
# Set the same value in Vercel Environment Variables, then send it with x-setup-token.
ADMIN_SETUP_TOKEN=""

# Keep empty for Neon/Supabase. Use "disable" only for a local PostgreSQL without SSL.
PGSSLMODE=""

# Lark SSO / permission gate.
# Keep AUTH_REQUIRED empty/false until Lark Developer Console is configured.
AUTH_REQUIRED="false"
AUTH_SESSION_SECRET=""
APP_BASE_URL="https://your-vercel-domain.vercel.app"
LARK_APP_ID=""
LARK_APP_SECRET=""
LARK_REDIRECT_URI="https://your-vercel-domain.vercel.app/api/auth/lark/callback"
LARK_OPEN_BASE_URL="https://open.larksuite.com"
LARK_AUTHORIZE_URL="https://accounts.larksuite.com/open-apis/authen/v1/authorize"
LARK_AUTH_SCOPE=""
LARK_AUTO_PROVISION="false"

# Supabase Storage private bucket for forecast file versions.
# DATABASE_URL still owns Postgres access; these values are only for Storage signed URLs.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="forecast-files"

# Lark Approval for KD01 submit flow.
# Set DRY_RUN=true while the approval definition/node ids are not ready.
LARK_FORECAST_APPROVAL_CODE=""
LARK_FORECAST_NODE_RSM="KD01_RSM_REVIEW"
LARK_FORECAST_NODE_GDKD="KD01_GDKD_REVIEW"
LARK_FORECAST_NODE_SUPPLY="KD01_SUPPLY_REVIEW"
LARK_FORECAST_NODE_FINANCE="KD01_FINANCE_REVIEW"
LARK_FORECAST_NODE_BI="KD01_BI_REVIEW"
LARK_FORECAST_NODE_CEO="KD01_CEO_APPROVAL"
LARK_APPROVAL_DRY_RUN="true"
